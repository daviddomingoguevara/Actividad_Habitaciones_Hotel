<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" prefWidth="400.0" prefHeight="300.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>

    <Label text="HotelApp - Buscador de Habitaciones">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Nº Habitación:" />
        <TextField fx:id="txtNumero" prefWidth="120.0" promptText="Ej. 101" />
        <Button fx:id="btnBuscar" text="Buscar" onAction="#buscarHabitacion" />
    </HBox>

    <Label fx:id="lblResultado" text="Introduce un número para consultar disponibilidad." wrapText="true">
        <font>
            <Font size="14.0" />
        </font>
    </Label>
</VBox>